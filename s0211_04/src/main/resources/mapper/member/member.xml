<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "//mybatis.org/DTD Mapper 3.0//EN" "../mybatis-3-mapper.dtd" >
<mapper namespace="com.java.mapper.MemberMapper">

  <!-- total과 함께 사용할 조건(따로 total을 조회할 경우 조건 한곳에서 수정하기 편하도록) -->
  <sql id="condition">
  	<!-- <if test='member.id != null and !member.id.equals("")'>
		and A.id = #{member.id}
    </if>
    <if test='member.pw != null and !member.pw.equals("")'>
    	and A.pw = #{member.pw}
    </if> -->
    <if test='id != null and !id.equals("")'>
		and A.id = #{id}
    </if>
    <if test='pw != null and !pw.equals("")'>
    	and A.pw = #{pw}
    </if>
    <if test='name != null and !name.equals("")'>
    	and A.name = #{name}
    </if>
  </sql>

  <select id="selectAll" resultType="member" parameterType="member">
  	select
  		A.id
  		,A.pw
  		,A.name
  		,A.email
  		,A.phone
  		,A.gender
  		,A.hobby
  		,count(*) over() as total_cnt
  	from member A
  	where 1=1
  	<include refid="condition" />
  </select>
  
  <select id="selectIdAndPw" resultType="member" parameterType="member">
  	select
  		A.id
  		,A.pw
  		,A.name
  		,A.email
  		,A.phone
  		,A.gender
  		,A.hobby
  	from member A
  	where 1=1
  	<include refid="condition" />
  </select>

  <select id="totalCnt" resultType="int" parameterType="member">
  	select
  		count(*) as total_cnt
  	from member A
  	where 1=1
  	<include refid="condition" />
  </select>


</mapper>