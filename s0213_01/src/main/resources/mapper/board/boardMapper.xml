<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "//mybatis.org/DTD Mapper 3.0//EN" "../mybatis-3-mapper.dtd" >
<mapper namespace="com.java.mapper.BoardMapper">

  <!-- total과 함께 사용할 조건(따로 total을 조회할 경우 조건 한곳에서 수정하기 편하도록) -->
  <sql id="condition">
  	<if test='search != null and !search.equals("")'>
        <choose>
            <when test='searchType == "0"'>
                and btitle like concat(#{btitle},'%')
            </when>
            <when test='searchType == "1"'>
                and bcontent like concat(#{bcontent},'%')
            </when>
        </choose>
    </if>
  </sql>

	<!-- com.java.dto.BoardDto alias설정으로 변경 -->
  <select id="selectAll" resultType="board" parameterType="board">
  	select
  		A.bno
  		,A.btitle
  		,DBMS_LOB.SUBSTR(A.bcontent, 4000, 1) as bcontent	<!-- 임시로 CLOB타입 String변환 4000바이트가 넘는 경우 절삭될 수 있음 -->
  		,A.id
  		,A.bgroup
  		,A.bstep
  		,A.bindent
  		,A.bhit
  		,A.bfile
  		,A.bdate
  		,count(*) over() as total_cnt
  	from board A
  	where 1=1
  	<include refid="condition" />
  	order by bgroup desc, bstep asc
  </select>

  <select id="totalCnt" resultType="int" parameterType="board">
  	select
  		count(*) as total_cnt
  	from board A
  	where 1=1
  	<include refid="condition" />
  </select>


</mapper>